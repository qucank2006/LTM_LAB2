<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.ftpmanager.client.controller.ClientController">
    <top>
        <VBox spacing="5" styleClass="panel">
            <Label text="FTP MANAGER" styleClass="title"/>
            <!-- Wrap complete label/control groups together at narrower widths. -->
            <FlowPane hgap="8" vgap="5" alignment="CENTER_LEFT">
                <HBox spacing="4" alignment="CENTER_LEFT"><Label text="Host"/><TextField fx:id="host" promptText="LAN IP / hostname" prefColumnCount="11"/></HBox>
                <HBox spacing="4" alignment="CENTER_LEFT"><Label text="Port"/><TextField fx:id="port" text="21" prefColumnCount="4"/></HBox>
                <HBox spacing="4" alignment="CENTER_LEFT"><Label text="Username"/><TextField fx:id="username" prefColumnCount="9"/></HBox>
                <HBox spacing="4" alignment="CENTER_LEFT"><Label text="Password"/><PasswordField fx:id="password" prefColumnCount="9"/></HBox>
                <HBox spacing="5" alignment="CENTER_LEFT"><Button text="Quick Connect" onAction="#connect"/><Button text="Disconnect" onAction="#disconnect"/></HBox>
                <HBox spacing="4" alignment="CENTER_LEFT"><Label text="Mode"/><ComboBox fx:id="mode" onAction="#changeMode"/></HBox>
                <HBox spacing="4" alignment="CENTER_LEFT"><Label text="Type"/><ComboBox fx:id="type" onAction="#changeMode"/></HBox>
            </FlowPane>
        </VBox>
    </top>
    <center>
        <SplitPane orientation="VERTICAL" dividerPositions="0.55,0.81">
            <items>
                <SplitPane dividerPositions="0.5" minHeight="160" minWidth="0">
                    <items>
                        <VBox spacing="5" styleClass="panel" minWidth="300">
                            <Label text="LOCAL FILES" styleClass="section-title"/>
                            <HBox spacing="4" alignment="CENTER_LEFT">
                                <Button text="↑" onAction="#localUp"/>
                                <TextField fx:id="localPath" minWidth="45" prefColumnCount="10" HBox.hgrow="ALWAYS" onAction="#localGo"/>
                                <Button text="Refresh" onAction="#refreshLocal"/>
                                <Button text="Upload →" onAction="#upload"/>
                            </HBox>
                            <SplitPane dividerPositions="0.23" minHeight="60" VBox.vgrow="ALWAYS">
                                <items><TreeView fx:id="localTree" minWidth="55"/><TableView fx:id="localFiles" minWidth="120"/></items>
                            </SplitPane>
                        </VBox>
                        <VBox spacing="5" styleClass="panel" minWidth="300">
                            <Label text="REMOTE FILES" styleClass="section-title"/>
                            <HBox spacing="4" alignment="CENTER_LEFT">
                                <Button text="↑" onAction="#remoteUp"/>
                                <TextField fx:id="remotePath" text="/" minWidth="45" prefColumnCount="10" HBox.hgrow="ALWAYS" onAction="#remoteGo"/>
                                <Button text="Refresh" onAction="#refreshRemote"/>
                                <Button text="← Download" onAction="#download"/>
                            </HBox>
                            <SplitPane dividerPositions="0.23" minHeight="60" VBox.vgrow="ALWAYS">
                                <items><TreeView fx:id="remoteTree" minWidth="55"/><TableView fx:id="remoteFiles" minWidth="120"/></items>
                            </SplitPane>
                        </VBox>
                    </items>
                </SplitPane>
                <VBox spacing="4" styleClass="panel" minHeight="110" prefHeight="135" SplitPane.resizableWithParent="false">
                    <HBox spacing="6" alignment="CENTER_LEFT">
                        <Label text="TRANSFER QUEUE / HISTORY" styleClass="section-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="Cancel selected" onAction="#cancelTransfer"/>
                        <Button text="Retry / Resume selected" onAction="#retryTransfer"/>
                    </HBox>
                    <TableView fx:id="queue" minHeight="50" VBox.vgrow="ALWAYS"/>
                </VBox>
                <VBox spacing="4" styleClass="panel" minHeight="80" prefHeight="100" SplitPane.resizableWithParent="false">
                    <Label text="PROTOCOL LOG" styleClass="section-title"/>
                    <TextArea fx:id="logs" editable="false" wrapText="true" minHeight="35" prefRowCount="3" VBox.vgrow="ALWAYS"/>
                </VBox>
            </items>
        </SplitPane>
    </center>
    <bottom><Label fx:id="status" text="Ready · Standard FTP · Trusted lab network only" styleClass="status-bar" maxWidth="Infinity"/></bottom>
</BorderPane>
